generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  apiKeys      ApiKey[]
  driveFolders DriveFolder[]
  driveFiles   DriveFile[]

  @@map("accounts")
}

model User {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([accountId])
  @@map("users")
}

// A raw API key is shown to the caller exactly once at issuance and never
// stored. `hashedKey` is HMAC-SHA256(pepper, rawKey) — deterministic, so a
// presented key can be looked up by recomputing the HMAC and querying for
// equality, without ever storing (or being able to recover) the raw key.
model ApiKey {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  hashedKey  String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([accountId])
  @@map("api_keys")
}

enum FolderStatus {
  CONNECTED
  NOT_ACCESSIBLE
}

// One row per (account, Google Drive folder). folderId is the raw
// user-pasted Drive folder ID, not our own primary key — verified against
// the shared service account's access before it's ever persisted as
// CONNECTED (see M3's POST /folders).
model DriveFolder {
  id             String       @id @default(cuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderId       String
  status         FolderStatus
  connectedAt    DateTime     @default(now())
  lastVerifiedAt DateTime     @default(now())
  driveFiles     DriveFile[]

  @@unique([accountId, folderId])
  @@index([accountId])
  @@map("drive_folders")
}

// One row per (DriveFolder, Drive file). Tracks exactly the state M4's
// change detection (modifiedTime), M10's dedup (contentHash), and M10's
// stale-vector cleanup (chunkCount) need between sync runs — those modules
// were built as pure functions ahead of this model existing; this is where
// they finally get real state to read from and write to (M12 wires it all
// together).
model DriveFile {
  id            String      @id @default(cuid())
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  driveFolderId String
  driveFolder   DriveFolder @relation(fields: [driveFolderId], references: [id], onDelete: Cascade)
  fileId        String
  name          String
  mimeType      String
  modifiedTime  String
  contentHash   String?
  chunkCount    Int         @default(0)
  lastSyncedAt  DateTime    @default(now())

  @@unique([driveFolderId, fileId])
  @@index([accountId])
  @@map("drive_files")
}
