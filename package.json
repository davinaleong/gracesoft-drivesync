{
  "name": "gracesoft-drivesync",
  "version": "0.1.0",
  "description": "Sync a Google Drive folder into a vector store for RAG retrieval, with pluggable embedding and vector-store providers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "express": "^4.21.0",
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.13.2",
    "googleapis": "^144.0.0",
    "openai": "^4.65.0",
    "@pinecone-database/pinecone": "^3.0.3",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5"
  }
}