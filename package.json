{
  "name": "gracesoft-drivesync",
  "version": "0.1.0",
  "private": true,
  "description": "GraceSoft DriveSync — Google Drive to Pinecone vector sync API, standalone service.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "env:check": "node --env-file=.env scripts/check-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@pinecone-database/pinecone": "^3.0.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^140.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "js-tiktoken": "^1.0.21",
    "openai": "^4.60.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.4.0",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^9.15.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.19.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.0.0"
  }
}