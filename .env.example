# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database & queue (fixed core stack — not swappable) ────────────────
DATABASE_URL=postgresql://drivesync:drivesync@localhost:5432/drivesync
REDIS_URL=redis://localhost:6379

# ── Auth (M2) ────────────────────────────────────────────────────────
# Random 32+ byte secret used as pepper when hashing issued API keys.
# Rotating this invalidates every previously issued API key.
API_KEY_PEPPER=

# ── Google Drive service account (M3) ───────────────────────────────
# Create a GCP service account, enable the Drive API, download a JSON key.
# Users connect a folder by sharing it with GOOGLE_SERVICE_ACCOUNT_EMAIL.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key from the JSON key file, with \n line breaks kept literal.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Embedding provider (M7) ─────────────────────────────────────────
# Selects which EmbeddingProvider adapter is active. Built-in: "openai".
# Changing this on a deployment with existing data requires a full resync
# (embedding dimension is fixed per provider — see M9).
EMBEDDING_PROVIDER=openai

# openai adapter config (used when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional. Requests a truncated output via OpenAI's "dimensions" API param
# instead of the model's native dimension (1536 for text-embedding-3-small).
# Only text-embedding-3-small/-large support this — not text-embedding-ada-002.
# Must match whatever dimension your Pinecone index was actually created with.
# OPENAI_EMBEDDING_DIMENSIONS=512

# ── Vector store provider (M8) ──────────────────────────────────────
# Selects which VectorStore adapter is active. Built-in: "pinecone".
VECTOR_STORE=pinecone

# pinecone adapter config (used when VECTOR_STORE=pinecone)
# PINECONE_INDEX_NAME must already exist, with a dimension matching the
# embedding output above (OPENAI_EMBEDDING_DIMENSIONS if set, else the
# model's native dimension) — a mismatch fails every sync run at startup.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=drivesync

# ── Scheduling (M11) ─────────────────────────────────────────────────
# Cron expression for the recurring sync job.
SYNC_CRON=*/15 * * * *
# Max concurrent Drive API calls per account, to respect the shared
# service account's quota across all connected folders.
DRIVE_RATE_LIMIT_PER_ACCOUNT=5

# ── MCP server (M13) ─────────────────────────────────────────────────
MCP_SERVER_PORT=3001
