# --- Server ---
PORT=4001
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting (express-rate-limit + rate-limit-redis) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Own auth (API keys — replaces v1's shared JWT) ---
# Keys are stored as a sha256 hash, never in plaintext. This pepper is
# concatenated before hashing as defense-in-depth (a stolen DB dump alone
# isn't enough to brute-force keys) — optional but recommended.
API_KEY_HASH_PEPPER=

# --- Google Drive (service-account share model) ---
# One shared service account across all connected accounts/folders — users
# grant access by sharing their folder with this account's email
# (client_email inside the JSON below), not via per-user OAuth.
GOOGLE_CLOUD_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Pinecone (vector store) ---
# One shared index; each account's vectors live in their own namespace at
# runtime (e.g. `account-<accountId>`) — no static namespace env var
# anymore, unlike v1's single-tenant PINECONE_NAMESPACE.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- OpenAI (embeddings) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the Pinecone index's configured dimension. Optional: omitted
# means "use the model's default."
EMBEDDING_DIMENSIONS=

# --- Postgres (own DB — no longer shared with dish-lens) ---
DATABASE_URL=postgresql://user:password@localhost:5432/gracesoft_drivesync

# --- Redis (BullMQ + rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Sync job scheduling ---
SYNC_QUEUE_NAME=drive-sync
SYNC_CRON_SCHEDULE=*/15 * * * *